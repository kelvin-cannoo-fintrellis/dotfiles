#!/bin/bash
set -e

# Wipes the shared database volume and re-runs every migration from scratch.
# Database bootstrap is split by ownership: the chassis owns the PSP-agnostic schema
# and seed data, each PSP repo owns its own databases and acquirer rows. Each repo's
# `make db-migrate` runs the chassis executor first, then its own.
#
# The wipe happens once here, so that resetting both PSPs leaves both sets of data in
# the shared database instead of the second wipe clearing the first PSP's.
#
# usage: reset-db [fuze|payin|both]   (default: both)

CHASSIS=~/repos/payment-gateway-chassis

case "${1:-both}" in
  fuze)  PSPS=(fuze) ;;
  payin) PSPS=(payin) ;;
  both)  PSPS=(fuze payin) ;;
  *)     echo "usage: reset-db [fuze|payin|both]" >&2; exit 1 ;;
esac

echo "=== Wiping infrastructure volumes ==="
docker compose -f "$CHASSIS/docker-compose.infra.yml" down -v

for psp in "${PSPS[@]}"; do
  echo "=== Migrating databases for $psp ==="
  (cd ~/repos/"$psp"-payment-gateway && make db-migrate)
done

echo "DB reset complete."
